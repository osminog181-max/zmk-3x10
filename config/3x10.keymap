#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define NUMPAD 1
#define BLT 2

/ {
    behaviors {
        hrm_r: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <
            0 1 2 3 4
            10 11 12 13 14
            20 21 22 23 24
            >;
        };
    };

    behaviors {
        hrm_l: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <
            5 6 7 8
            15 16 17 18 19
            25 26 27 28 29
            >;
        };
    };

    combos {
        compatible = "zmk,combos";

        copy {
            timeout-ms = <45>;
            require-prior-idle-ms = <130>;
            slow-release;
            bindings = <&kp LC(C)>;
            key-positions = <39 27>;
        };

        cut {
            timeout-ms = <45>;
            require-prior-idle-ms = <130>;
            slow-release;
            bindings = <&kp LC(X)>;
            key-positions = <39 26>;
        };

        paste {
            timeout-ms = <45>;
            require-prior-idle-ms = <130>;
            slow-release;
            bindings = <&kp LC(V)>;
            key-positions = <39 28>;
        };

        backspace {
            timeout-ms = <60>;
            require-prior-idle-ms = <180>;
            bindings = <&kp BACKSPACE>;
            key-positions = <5 4>;
        };

        print {
            timeout-ms = <50>;
            require-prior-idle-ms = <160>;
            layers = <0>;
            bindings = <&kp LC(P)>;
            key-positions = <1 2>;
        };

        insert {
            timeout-ms = <50>;
            require-prior-idle-ms = <160>;
            layers = <0>;
            bindings = <&kp INSERT>;
            key-positions = <1 3>;
        };

        qstn {
            bindings = <&kp LS(N7)>;
            key-positions = <6 7>;
        };

        rght_skbk {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <4 3>;
            layers = <0>;
        };

        lft_skbk {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <2 3>;
            layers = <0>;
        };

        calculator {
            bindings = <&kp C_AL_CALCULATOR>;
            key-positions = <5 41>;
            layers = <0>;
        };

        caps {
            bindings = <&kp CAPS>;
            key-positions = <37 40>;
            layers = <0>;
        };

        to_numa {
            bindings = <&to 0>;
            key-positions = <0 36>;
        };

        to_simb {
            bindings = <&to 0>;
            key-positions = <48 50>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <16 17>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&kp Q           &kp W          &kp E           &kp R          &kp T  &kp Y  &kp U           &kp I          &kp O           &kp K_MUTE
&hrm_l LCTRL A  &hrm_l LALT S  &hrm_l LSHFT D  &hrm_l LGUI F  &kp G  &kp H  &hrm_r RSHFT J  &hrm_r RALT K  &hrm_r RCTRL L  &kp P
&kp Z           &kp X          &kp C           &kp V          &kp B  &kp N  &kp M           &kp COMMA      &kp DOT         &to 0
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            label = "base";
        };
    };
};
