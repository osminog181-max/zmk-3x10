#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define NUMPAD 1
#define BLT 2

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&kp N1  &kp N1  &kp E   &kp R   &kp T   &kp Y   &kp U   &kp I      &kp O    &kp K_MUTE
&kp N1  &kp N1  &kp N1  &kp N1  &kp N1  &kp N1  &kp N1  &kp N1     &kp N1   &kp P
&kp Z   &kp X   &kp C   &kp V   &kp B   &kp N   &kp M   &kp COMMA  &kp DOT  &to 0
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            label = "base";
        };
    };
};
