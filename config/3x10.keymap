#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define NUMPAD 1
#define BLT 2

/ {
    behaviors {
        hrm_r: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
            0 1 2 3 4
            10 11 12 13 14
            20 21 22 23 24
            >;
        };

        hrm_l: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
            5 6 7 8
            15 16 17 18 19
            25 26 27 28 29
            >;
        };

        tolay: tolay {
            compatible = "zmk,behavior-hold-tap";
            label = "TOLAY";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 7>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <18 17>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <7 6>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&kp Q       &kp W          &kp E           &kp R                &hrm_l GRAVE T     &kp Y         &kp U           &kp I                      &kp O                     &kp C_MUTE
&tolay 2 A  &hrm_l LALT S  &hrm_l LCTRL D  &hrm_l LEFT_SHIFT F  &hrm_l G LEFT_GUI  &kp H         &hrm_r RSHFT J  &hrm_r RALT K              &hrm_r RCTRL L            &tolay 1 P
&kp Z       &kp X          &kp C           &kp V                &kp B              &hrm_r SQT N  &hrm_r SQT M    &hrm_r LEFT_BRACKET COMMA  &hrm_r RIGHT_BRACKET DOT  &kp SLASH
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            label = "base";
        };

        simb_numa {
            bindings = <
&kp N7  &kp N8  &kp N9  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp QUESTION  &kp MINUS  &kp C_MUTE
&kp N4  &kp N5  &kp N6  &kp N0  &trans  &trans                &trans                 &trans        &trans     &mo 1
&kp N7  &kp N8  &kp N9  &trans  &trans  &trans                &trans                 &trans        &trans     &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
